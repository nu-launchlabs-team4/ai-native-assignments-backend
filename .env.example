# Supabase Session pooler string. Use the postgresql+psycopg:// scheme and no brackets around the password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY
# The AI features' model: claude_code (default; local development on your own Claude Code
# login), anthropic (needs ANTHROPIC_API_KEY; staging and the showcase), or fake (offline).
AI_PROVIDER=claude_code
# For AI_PROVIDER=claude_code in Docker: run `claude setup-token` on your machine and paste it.
CLAUDE_CODE_OAUTH_TOKEN=YOUR-CLAUDE-CODE-OAUTH-TOKEN
# For AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
# Comma-separated
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated emails that sign up as professors. Everyone else is a student.
PROFESSOR_EMAILS=professor@example.edu
ENV=local
